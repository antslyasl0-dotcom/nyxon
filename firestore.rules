rules_version = '2';

// ⚠️ القواعد المبسّطة — المنشورة حالياً.
//
//   يقرأ:  الكل، بدون حساب.
//   يكتب:  أي شخص مسجّل دخول بقوقل — بدون نظر لرتبته.
//
// فيها راحة: الكابتن والإدارة يشتغلون فوراً بدون طلبات ولا موافقات.
// وفيها خطر: الرابط عام، فأي شخص يوصله ويسجّل دخول يقدر يمسح اللاعبين
// ويغيّر النتائج. ما فيه شي يمنعه.
//
// النسخة المحكمة محفوظة في firestore.rules.strict — فيها الصلاحية تتبع
// الرتبة (إدارة / كابتن / نائب / لاعب) ويفرضها السيرفر مو الواجهة.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }
  }
}
